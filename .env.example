# Project-local OpenMinion home. Never point this at ~/.local/share.
OPENMINION_HOME=/workspace/hackathons/cortensor/.om-home
OPENMINION_DATA_ROOT=/workspace/hackathons/cortensor/.om-home/.openminion

# Optional model providers. Leave empty to use deterministic mode or a local
# echo/ollama config. Do not commit secrets. Portal and Router are optional.
# CORTENSOR_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Agent profile written by `openminion setup` (for example ollama or cortensor-portal).
DOSSIER_AGENT_ID=
DOSSIER_MODEL=
# Auto-approve file_case only in tests. Leave unset for a human prompt.
DOSSIER_AUTO_APPROVE=0
